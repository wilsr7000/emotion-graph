{
  "name": "@journey-map/emotion-graph",
  "version": "1.0.0",
  "description": "A customizable, interactive emotion graph component for visualizing customer satisfaction across journey stages",
  "type": "module",
  "main": "dist/emotion-graph.js",
  "module": "dist/emotion-graph.esm.js",
  "types": "dist/types/index.d.ts",
  "scripts": {
    "build": "rollup -c",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "docs": "jsdoc -c jsdoc.json",
    "prepare": "npm run build",
    "start": "cd examples/basic && python -m http.server 8000"
  },
  "keywords": [
    "emotion-graph",
    "customer-journey",
    "visualization",
    "satisfaction",
    "interactive",
    "svg",
    "chart",
    "emoji"
  ],
  "author": "Richard Wilson",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/richardwilson/emotion-graph"
  },
  "bugs": {
    "url": "https://github.com/richardwilson/emotion-graph/issues"
  },
  "homepage": "https://github.com/richardwilson/emotion-graph#readme",
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.22.20",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.5",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "jsdoc": "^4.0.2",
    "prettier": "^3.0.3",
    "rollup": "^4.0.2"
  },
  "files": [
    "dist",
    "src"
  ]
} 